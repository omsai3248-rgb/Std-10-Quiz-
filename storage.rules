rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStorageAdmin() {
      return request.auth != null && (
        ('phone_number' in request.auth.token && request.auth.token.phone_number == '+919099592283') ||
        ('email' in request.auth.token && request.auth.token.email == 'admin9099592283@std10quiz.app') ||
        ('email' in request.auth.token && request.auth.token.email == 'omsai3248@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    match /payment_screenshots/{userId}/{fileName} {
      // Signed-in user can upload payment screenshot image up to 5 MB
      allow create: if request.auth != null &&
                       request.auth.uid == userId &&
                       request.resource.size < 5 * 1024 * 1024 &&
                       request.resource.contentType.matches('image/.*');

      // Only the submitting user or Admin can read the payment screenshot
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isStorageAdmin()
      );

      allow update, delete: if false;
    }

    match /app_releases/{fileName} {
      // All users can download verified release APKs inside the app
      allow read: if true;

      // Only authenticated Admin can upload/replace or delete APK binaries (up to 250 MB)
      allow create, update: if isStorageAdmin() &&
                               fileName.matches('^[a-zA-Z0-9._-]+\\.apk$') &&
                               request.resource.size > 0 &&
                               request.resource.size < 250 * 1024 * 1024 &&
                               (
                                 request.resource.contentType == 'application/vnd.android.package-archive' ||
                                 request.resource.contentType == 'application/octet-stream'
                               );

      allow delete: if isStorageAdmin();
    }

    match /voice_cache/{gender}/{fileName} {
      // Any quiz user can stream cached natural Gujarati voice clips
      allow read: if true;

      // Immutable content-addressed SHA-256 WAV audio cache (max 10 MB)
      allow create: if gender in ['female', 'male'] &&
                       fileName.matches('^[a-f0-9]{64}\\.wav$') &&
                       request.resource.size > 44 &&
                       request.resource.size < 10 * 1024 * 1024 &&
                       (
                         request.resource.contentType == 'audio/wav' ||
                         request.resource.contentType == 'audio/x-wav' ||
                         request.resource.contentType == 'audio/wave'
                       );

      allow update: if false;
      allow delete: if isStorageAdmin();
    }
  }
}
