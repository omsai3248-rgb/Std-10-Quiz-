rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailDocId(id) {
      return id is string && id.size() >= 5 && id.size() <= 120 && id.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isValidPublicUid(uid) {
      return uid is string && uid.matches('^pub_[a-f0-9]{32}$');
    }

    function isValidMobileStudentId(id) {
      return id is string && id.matches('^mob_[0-9]{10}$') && id != 'mob_9099592283';
    }

    function isValidPayId(id) {
      return id is string && id.matches('^pay_[a-f0-9]{32}$');
    }

    function isValidUtrKey(utr) {
      return utr is string && utr.size() >= 4 && utr.size() <= 64 && utr.matches('^[A-Z0-9_\\-]+$');
    }

    // Super Admin: owner Google verified email or primary admin phone account
    function isSuperAdmin() {
      return isSignedIn() && (
        ('phone_number' in request.auth.token && request.auth.token.phone_number == '+919099592283') ||
        ('email' in request.auth.token && request.auth.token.email == 'admin9099592283@std10quiz.app') ||
        ('email' in request.auth.token && request.auth.token.email == 'omsai3248@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Verified Multi-Admin check: Super Admin, active /admins/{uid} record, or verified email in /admin_invites
    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          (
            'email' in request.auth.token &&
            'email_verified' in request.auth.token &&
            request.auth.token.email_verified == true &&
            request.auth.token.email is string &&
            exists(/databases/$(database)/documents/admin_invites/$(request.auth.token.email.lower()))
          )
        )
      );
    }

    function canUseReservedAdminMobile(data) {
      return data.mobileNumber != '9099592283' || isAdmin();
    }

    function isStudentDocOwner(userId, data) {
      return (isSignedIn() && request.auth.uid == userId) ||
             (isValidMobileStudentId(userId) && userId == 'mob_' + data.mobileNumber);
    }

    function hasSubjectAccess(studentData, subjectId) {
      return studentData.hasQuizAccess == true ||
             ('unlockedSubjects' in studentData && (
               'all' in studentData.unlockedSubjects ||
               subjectId in studentData.unlockedSubjects
             ));
    }

    function isValidStudent(data) {
      return data.keys().hasAll([
               'userId', 'fullName', 'mobileNumber', 'email', 'standard',
               'hasQuizAccess', 'redeemedCode', 'paymentStatus',
               'totalQuizzesTaken', 'bestScorePercent', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'fullName', 'mobileNumber', 'email', 'standard',
               'hasQuizAccess', 'redeemedCode', 'paymentStatus',
               'totalQuizzesTaken', 'bestScorePercent', 'unlockedSubjects',
               'freeMockUsedSubjects', 'paymentRequestIds', 'activeDeviceId', 'activeDeviceName',
               'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 60 &&
             data.mobileNumber is string && data.mobileNumber.matches('^[0-9]{10}$') &&
             data.email is string && data.email.size() <= 120 &&
             data.standard is string && data.standard.size() >= 1 && data.standard.size() <= 30 &&
             data.hasQuizAccess is bool &&
             data.redeemedCode is string && data.redeemedCode.size() <= 32 &&
             data.paymentStatus in ['none', 'pending', 'approved', 'rejected'] &&
             data.totalQuizzesTaken is int && data.totalQuizzesTaken >= 0 && data.totalQuizzesTaken <= 100000 &&
             data.bestScorePercent is int && data.bestScorePercent >= 0 && data.bestScorePercent <= 100 &&
             (!('unlockedSubjects' in data) || (data.unlockedSubjects is list && data.unlockedSubjects.size() <= 10)) &&
             (!('freeMockUsedSubjects' in data) || (data.freeMockUsedSubjects is list && data.freeMockUsedSubjects.size() <= 6 && data.freeMockUsedSubjects.hasOnly(['maths', 'science', 'social_science', 'english', 'gujarati', 'hindi']))) &&
             (!('paymentRequestIds' in data) || (data.paymentRequestIds is list && data.paymentRequestIds.size() <= 25)) &&
             (!('activeDeviceId' in data) || (data.activeDeviceId is string && data.activeDeviceId.size() <= 128)) &&
             (!('activeDeviceName' in data) || (data.activeDeviceName is string && data.activeDeviceName.size() <= 120)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUsedByMap(usedBy) {
      return usedBy is map &&
             usedBy.keys().hasAll(['uid', 'name', 'mobile', 'deviceInfo']) &&
             usedBy.keys().hasOnly(['uid', 'name', 'mobile', 'deviceInfo']) &&
             usedBy.uid is string && usedBy.uid.size() >= 1 && usedBy.uid.size() <= 128 &&
             usedBy.name is string && usedBy.name.size() >= 1 && usedBy.name.size() <= 60 &&
             usedBy.mobile is string && usedBy.mobile.matches('^[0-9]{10}$') &&
             usedBy.deviceInfo is string && usedBy.deviceInfo.size() >= 1 && usedBy.deviceInfo.size() <= 200;
    }

    function isValidAccessCode(data) {
      return data.keys().hasAll([
               'code', 'requestId', 'userName', 'mobileNumber', 'amountRupees',
               'batchName', 'status', 'isUsed', 'usedByUserId', 'usedByMobile',
               'usedByName', 'source', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'code', 'requestId', 'userName', 'mobileNumber', 'amountRupees',
               'batchName', 'status', 'isUsed', 'usedAt', 'usedBy',
               'usedByUserId', 'usedByMobile', 'usedByName', 'source',
               'subjectId', 'createdAt', 'updatedAt'
             ]) &&
             data.code is string && data.code.size() >= 4 && data.code.size() <= 32 && data.code.matches('^[A-Z0-9_\\-]+$') &&
             data.requestId is string && data.requestId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 60 &&
             data.mobileNumber is string && data.mobileNumber.size() <= 15 &&
             data.amountRupees is int && data.amountRupees >= 0 && data.amountRupees <= 100000 &&
             data.batchName is string && data.batchName.size() >= 1 && data.batchName.size() <= 60 &&
             data.status in ['unused', 'used'] &&
             data.isUsed is bool &&
             data.isUsed == (data.status == 'used') &&
             (!('usedAt' in data) || data.usedAt == null || (data.usedAt is timestamp && data.usedAt <= request.time)) &&
             (!('usedBy' in data) || data.usedBy == null || isValidUsedByMap(data.usedBy)) &&
             data.usedByUserId is string && data.usedByUserId.size() <= 128 &&
             data.usedByMobile is string && data.usedByMobile.size() <= 15 &&
             data.usedByName is string && data.usedByName.size() <= 60 &&
             data.source in ['book', 'upi_payment'] &&
             (!('subjectId' in data) || data.subjectId in ['maths', 'science', 'social_science', 'english', 'gujarati', 'hindi', 'all']) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPaymentRequest(data) {
      return data.keys().hasAll([
               'userId', 'studentName', 'mobileNumber', 'amountRupees', 'upiId',
               'upiTransactionRef', 'utrNormalized', 'screenshotUrl', 'screenshotPath',
               'screenshotBase64', 'status', 'assignedCode', 'adminNote',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'studentName', 'mobileNumber', 'amountRupees', 'upiId',
               'upiTransactionRef', 'utrNormalized', 'screenshotUrl', 'screenshotPath',
               'screenshotBase64', 'status', 'assignedCode', 'adminNote', 'subjectId',
               'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 60 &&
             data.mobileNumber is string && data.mobileNumber.matches('^[0-9]{10}$') &&
             data.amountRupees is int && data.amountRupees >= 1 && data.amountRupees <= 100000 &&
             data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 60 &&
             data.upiTransactionRef is string && data.upiTransactionRef.size() >= 4 && data.upiTransactionRef.size() <= 64 &&
             isValidUtrKey(data.utrNormalized) &&
             data.screenshotUrl is string && data.screenshotUrl.size() <= 2000 &&
             data.screenshotPath is string && data.screenshotPath.size() <= 300 &&
             data.screenshotBase64 is string && data.screenshotBase64.size() <= 450000 &&
             (data.screenshotUrl.size() >= 10 || data.screenshotBase64.size() >= 10) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.assignedCode is string && data.assignedCode.size() <= 32 &&
             data.adminNote is string && data.adminNote.size() <= 200 &&
             (!('subjectId' in data) || data.subjectId in ['maths', 'science', 'social_science', 'english', 'gujarati', 'hindi', 'all']) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidQuizAttempt(data) {
      return data.keys().hasAll([
               'userId', 'subjectId', 'subjectTitle', 'chapterTitle',
               'score', 'totalQuestions', 'percentage', 'timeTakenSeconds', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'subjectId', 'subjectTitle', 'chapterTitle',
               'score', 'totalQuestions', 'percentage', 'timeTakenSeconds', 'createdAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.subjectId in ['maths', 'science', 'social_science', 'english', 'gujarati', 'hindi'] &&
             data.subjectTitle is string && data.subjectTitle.size() >= 1 && data.subjectTitle.size() <= 50 &&
             data.chapterTitle is string && data.chapterTitle.size() >= 1 && data.chapterTitle.size() <= 100 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 200 &&
             data.score is int && data.score >= 0 && data.score <= data.totalQuestions &&
             data.percentage is int && data.percentage >= 0 && data.percentage <= 100 &&
             data.timeTakenSeconds is int && data.timeTakenSeconds >= 0 && data.timeTakenSeconds <= 7200 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidNotificationPrefs(prefs) {
      return prefs is map &&
             prefs.keys().hasAll([
               'registrations', 'logins', 'payments', 'codeRedemptions',
               'quizActivity', 'dataUpdates', 'adminChat'
             ]) &&
             prefs.keys().hasOnly([
               'registrations', 'logins', 'payments', 'codeRedemptions',
               'quizActivity', 'dataUpdates', 'adminChat'
             ]) &&
             prefs.registrations is bool &&
             prefs.logins is bool &&
             prefs.payments is bool &&
             prefs.codeRedemptions is bool &&
             prefs.quizActivity is bool &&
             prefs.dataUpdates is bool &&
             prefs.adminChat is bool;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll([
               'uid', 'email', 'displayName', 'photoUrl', 'role',
               'isActive', 'notificationPrefs', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'uid', 'email', 'displayName', 'photoUrl', 'role',
               'isActive', 'notificationPrefs', 'createdAt', 'updatedAt'
             ]) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 120 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.photoUrl is string && data.photoUrl.size() <= 500 &&
             data.role in ['super_admin', 'admin'] &&
             data.isActive is bool &&
             isValidNotificationPrefs(data.notificationPrefs) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminInvite(data) {
      return data.keys().hasAll(['email', 'displayName', 'addedByUid', 'createdAt']) &&
             data.keys().hasOnly(['email', 'displayName', 'addedByUid', 'createdAt']) &&
             isValidEmailDocId(data.email) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.addedByUid is string && data.addedByUid.size() >= 1 && data.addedByUid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAdminFcmToken(data) {
      return data.keys().hasAll([
               'adminUid', 'adminEmail', 'adminName', 'token', 'platform',
               'deviceId', 'deviceName', 'appVersion', 'enabled', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'adminUid', 'adminEmail', 'adminName', 'token', 'platform',
               'deviceId', 'deviceName', 'appVersion', 'enabled', 'createdAt', 'updatedAt'
             ]) &&
             data.adminUid is string && data.adminUid.size() >= 1 && data.adminUid.size() <= 128 &&
             data.adminEmail is string && data.adminEmail.size() <= 120 &&
             data.adminName is string && data.adminName.size() >= 1 && data.adminName.size() <= 80 &&
             data.token is string && data.token.size() >= 20 && data.token.size() <= 512 &&
             data.platform in ['android', 'web'] &&
             isValidId(data.deviceId) &&
             data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 120 &&
             data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 32 &&
             data.enabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminNotification(data) {
      return data.keys().hasAll([
               'category', 'title', 'body', 'actorName', 'actorMobile', 'actorId',
               'targetRoute', 'referenceId', 'isRead', 'readBy', 'pushDispatched',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'category', 'title', 'body', 'actorName', 'actorMobile', 'actorId',
               'targetRoute', 'referenceId', 'isRead', 'readBy', 'pushDispatched',
               'createdAt', 'updatedAt'
             ]) &&
             data.category in ['registration', 'login', 'payment', 'code_redeem', 'quiz_activity', 'data_update', 'admin_chat'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 400 &&
             data.actorName is string && data.actorName.size() <= 80 &&
             data.actorMobile is string && data.actorMobile.size() <= 15 &&
             data.actorId is string && data.actorId.size() <= 128 &&
             data.targetRoute in ['admin_requests', 'admin_codes', 'admin_students', 'admin_updates', 'admin_notifications'] &&
             data.referenceId is string && data.referenceId.size() <= 128 &&
             data.isRead is bool &&
             data.readBy is list && data.readBy.size() <= 20 && (data.readBy.size() == 0 || data.readBy[0] is string) &&
             data.pushDispatched is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminChat(data) {
      return data.keys().hasAll([
               'participants', 'lastMessageText', 'lastMessageSenderUid', 'lastMessageSenderName',
               'lastMessageStatus', 'lastMessageAt', 'unreadCounts', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'participants', 'participantMeta', 'lastMessageText', 'lastMessageSenderUid',
               'lastMessageSenderName', 'lastMessageStatus', 'lastMessageAt', 'unreadCounts',
               'createdAt', 'updatedAt'
             ]) &&
             data.participants is list && data.participants.size() == 2 &&
             data.participants[0] is string && data.participants[1] is string &&
             data.participants[0] != data.participants[1] &&
             (!('participantMeta' in data) || data.participantMeta is map) &&
             data.lastMessageText is string && data.lastMessageText.size() <= 500 &&
             data.lastMessageSenderUid is string && data.lastMessageSenderUid.size() <= 128 &&
             data.lastMessageSenderName is string && data.lastMessageSenderName.size() <= 80 &&
             data.lastMessageStatus in ['sent', 'delivered', 'read'] &&
             data.lastMessageAt is timestamp && data.lastMessageAt <= request.time &&
             data.unreadCounts is map &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminChatMessage(data) {
      return data.keys().hasAll([
               'chatId', 'senderUid', 'senderName', 'senderPhotoUrl', 'recipientUid',
               'participantUids', 'text', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'chatId', 'senderUid', 'senderName', 'senderPhotoUrl', 'recipientUid',
               'participantUids', 'text', 'status', 'deliveredAt', 'readAt',
               'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.chatId) &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             data.senderPhotoUrl is string && data.senderPhotoUrl.size() <= 500 &&
             data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid.size() <= 128 &&
             data.recipientUid != data.senderUid &&
             data.participantUids is list && data.participantUids.size() == 2 &&
             data.senderUid in data.participantUids &&
             data.recipientUid in data.participantUids &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.status in ['sent', 'delivered', 'read'] &&
             (!('deliveredAt' in data) || data.deliveredAt == null || (data.deliveredAt is timestamp && data.deliveredAt <= request.time)) &&
             (!('readAt' in data) || data.readAt == null || (data.readAt is timestamp && data.readAt <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Verified Admin Directory Profiles & Notification Preferences
    match /admins/{adminUid} {
      allow get: if isSignedIn() && (isAdmin() || request.auth.uid == adminUid);
      allow list: if isAdmin();

      allow create: if isValidId(adminUid) &&
                       isValidAdminUser(incoming()) &&
                       incoming().uid == adminUid && (
                         isSuperAdmin() ||
                         (
                           isAdmin() &&
                           request.auth.uid == adminUid &&
                           incoming().role == 'admin' &&
                           incoming().isActive == true
                         )
                       );

      allow update: if isValidId(adminUid) &&
                       isValidAdminUser(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt && (
                         isSuperAdmin() ||
                         (
                           isAdmin() &&
                           request.auth.uid == adminUid &&
                           incoming().role == existing().role &&
                           incoming().isActive == existing().isActive &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'email', 'photoUrl', 'notificationPrefs', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isSuperAdmin() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    // Super Admin Email Allowlist for Adding Extra Admins
    match /admin_invites/{inviteEmail} {
      allow get: if isSuperAdmin() || (
        isSignedIn() &&
        'email' in request.auth.token &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == inviteEmail
      );
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() &&
                               isValidEmailDocId(inviteEmail) &&
                               isValidAdminInvite(incoming()) &&
                               incoming().email == inviteEmail &&
                               incoming().addedByUid == request.auth.uid;
      allow delete: if isSuperAdmin() && isValidEmailDocId(inviteEmail);
    }

    // Multi-device, Multi-admin FCM Registration Tokens (Strictly Admin-only)
    match /admin_fcm_tokens/{tokenDocId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(tokenDocId) &&
                       isValidAdminFcmToken(incoming()) &&
                       incoming().adminUid == request.auth.uid;
      allow update: if isAdmin() &&
                       isValidId(tokenDocId) &&
                       isValidAdminFcmToken(incoming()) &&
                       incoming().adminUid == request.auth.uid &&
                       incoming().adminUid == existing().adminUid &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() &&
                       isValidId(tokenDocId) &&
                       (existing().adminUid == request.auth.uid || isSuperAdmin());
    }

    // Persistent Admin Notification Center
    match /admin_notifications/{notifId} {
      allow get, list: if isAdmin();

      // Authenticated Admins or public student events can log bounded, unread notifications;
      // non-admins CANNOT forge admin_chat alerts, read any notifications, mark read, or delete.
      allow create: if isValidId(notifId) &&
                       isValidAdminNotification(incoming()) &&
                       incoming().isRead == false &&
                       incoming().readBy.size() == 0 &&
                       incoming().pushDispatched == false && (
                         isAdmin() ||
                         incoming().category in ['registration', 'login', 'payment', 'code_redeem', 'quiz_activity', 'data_update']
                       );

      allow update: if isAdmin() &&
                       isValidId(notifId) &&
                       isValidAdminNotification(incoming()) &&
                       incoming().category == existing().category &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readBy', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(notifId);
    }

    // Real-time 1-to-1 Admin Personal Messaging (Strictly Authenticated Admins & Chat Participants Only)
    match /admin_chats/{chatId} {
      allow get: if isAdmin() && isValidId(chatId) && (resource == null || request.auth.uid in existing().participants);
      allow list: if isAdmin() && request.auth.uid in existing().participants;

      allow create: if isAdmin() &&
                       isValidId(chatId) &&
                       isValidAdminChat(incoming()) &&
                       request.auth.uid in incoming().participants;

      allow update: if isAdmin() &&
                       isValidId(chatId) &&
                       isValidAdminChat(incoming()) &&
                       request.auth.uid in existing().participants &&
                       incoming().participants == existing().participants &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isAdmin() && isValidId(messageId) && (resource == null || request.auth.uid in existing().participantUids);
        allow list: if isAdmin() && request.auth.uid in existing().participantUids;

        allow create: if isAdmin() &&
                         isValidId(messageId) &&
                         isValidAdminChatMessage(incoming()) &&
                         incoming().chatId == chatId &&
                         incoming().senderUid == request.auth.uid &&
                         request.auth.uid in incoming().participantUids &&
                         incoming().status == 'sent' &&
                         !('deliveredAt' in incoming()) &&
                         !('readAt' in incoming()) &&
                         exists(/databases/$(database)/documents/admin_chats/$(chatId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/admin_chats/$(chatId)).data.participants &&
                         incoming().recipientUid in get(/databases/$(database)/documents/admin_chats/$(chatId)).data.participants;

        // Only the recipient Admin can advance status sent -> delivered -> read
        allow update: if isAdmin() &&
                         isValidId(messageId) &&
                         isValidAdminChatMessage(incoming()) &&
                         request.auth.uid in existing().participantUids &&
                         incoming().senderUid == existing().senderUid &&
                         incoming().recipientUid == existing().recipientUid &&
                         incoming().chatId == existing().chatId &&
                         incoming().participantUids == existing().participantUids &&
                         incoming().text == existing().text &&
                         incoming().createdAt == existing().createdAt &&
                         request.auth.uid == existing().recipientUid &&
                         (
                           (existing().status == 'sent' && incoming().status in ['delivered', 'read']) ||
                           (existing().status == 'delivered' && incoming().status == 'read')
                         ) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deliveredAt', 'readAt', 'updatedAt']);

        allow delete: if false;
      }
    }

    // Students collection (tracks unlocked content, payment IDs & quiz stats per student ID or signed-in UID)
    match /students/{userId} {
      allow get: if isAdmin() || (
        isValidId(userId) && (
          (isSignedIn() && request.auth.uid == userId) ||
          isValidMobileStudentId(userId)
        )
      );
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
                       isValidStudent(incoming()) &&
                       canUseReservedAdminMobile(incoming()) &&
                       isStudentDocOwner(userId, incoming()) &&
                       incoming().userId == userId &&
                       incoming().hasQuizAccess == false &&
                       incoming().redeemedCode == '' &&
                       incoming().paymentStatus == 'none' &&
                       incoming().totalQuizzesTaken == 0 &&
                       incoming().bestScorePercent == 0 &&
                       (!('unlockedSubjects' in incoming()) || incoming().unlockedSubjects.size() == 0) &&
                       (!('freeMockUsedSubjects' in incoming()) || incoming().freeMockUsedSubjects.size() == 0) &&
                       (!('paymentRequestIds' in incoming()) || incoming().paymentRequestIds.size() == 0);

      allow update: if isValidId(userId) &&
                       isValidStudent(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           isStudentDocOwner(userId, incoming()) &&
                           canUseReservedAdminMobile(incoming()) && (
                             incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'email', 'updatedAt']) ||
                             (
                               'activeDeviceId' in incoming() &&
                               incoming().activeDeviceId is string &&
                               incoming().activeDeviceId.size() >= 1 &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'email', 'activeDeviceId', 'activeDeviceName', 'updatedAt'])
                             ) ||
                             (
                               'activeDeviceId' in incoming() &&
                               incoming().activeDeviceId == '' &&
                               (!('activeDeviceName' in incoming()) || incoming().activeDeviceName == '') &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['activeDeviceId', 'activeDeviceName', 'updatedAt'])
                             ) ||
                             (
                               isSignedIn() &&
                               request.auth.uid == userId &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'mobileNumber', 'email', 'activeDeviceId', 'activeDeviceName', 'updatedAt'])
                             ) ||
                             (
                               'freeMockUsedSubjects' in incoming() &&
                               incoming().freeMockUsedSubjects is list &&
                               incoming().freeMockUsedSubjects.size() <= 6 &&
                               incoming().freeMockUsedSubjects.hasOnly(['maths', 'science', 'social_science', 'english', 'gujarati', 'hindi']) &&
                               (!('freeMockUsedSubjects' in existing()) || incoming().freeMockUsedSubjects.hasAll(existing().freeMockUsedSubjects)) &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['freeMockUsedSubjects', 'updatedAt'])
                             ) ||
                             (
                               incoming().paymentStatus == 'pending' &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'paymentRequestIds', 'updatedAt'])
                             ) ||
                             (
                               incoming().redeemedCode.size() >= 4 &&
                               exists(/databases/$(database)/documents/access_codes/$(incoming().redeemedCode)) &&
                               get(/databases/$(database)/documents/access_codes/$(incoming().redeemedCode)).data.isUsed == false &&
                               getAfter(/databases/$(database)/documents/access_codes/$(incoming().redeemedCode)).data.isUsed == true &&
                               getAfter(/databases/$(database)/documents/access_codes/$(incoming().redeemedCode)).data.usedByUserId == userId &&
                               (
                                 incoming().hasQuizAccess == true ||
                                 ('unlockedSubjects' in incoming() && incoming().unlockedSubjects.size() >= 1)
                               ) &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['hasQuizAccess', 'redeemedCode', 'unlockedSubjects', 'updatedAt'])
                             ) ||
                             (
                               (existing().hasQuizAccess == true || ('unlockedSubjects' in existing() && existing().unlockedSubjects.size() >= 1)) &&
                               incoming().totalQuizzesTaken >= existing().totalQuizzesTaken &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['totalQuizzesTaken', 'bestScorePercent', 'updatedAt'])
                             )
                           )
                         )
                       );

      allow delete: if isAdmin() && isValidId(userId);

      match /quiz_attempts/{attemptId} {
        allow get: if isAdmin() || (
          isValidId(attemptId) && (
            (isSignedIn() && request.auth.uid == userId) ||
            isValidMobileStudentId(userId)
          )
        );
        allow list: if isAdmin() || (isSignedIn() && request.auth.uid == userId) || isValidMobileStudentId(userId);
        allow create: if isValidId(attemptId) &&
                         isValidQuizAttempt(incoming()) &&
                         incoming().userId == userId &&
                         ((isSignedIn() && request.auth.uid == userId) || isValidMobileStudentId(userId)) &&
                         hasSubjectAccess(get(/databases/$(database)/documents/students/$(userId)).data, incoming().subjectId);
        allow update, delete: if isAdmin() && isValidId(attemptId);
      }
    }

    // Unique UTR lock collection to enforce duplicate UTR prevention server-side
    match /utr_locks/{utrId} {
      allow get: if isValidUtrKey(utrId);
      allow list: if isAdmin();
      allow create: if isValidUtrKey(utrId) &&
                       incoming().keys().hasAll(['utrNormalized', 'requestId', 'createdAt']) &&
                       incoming().keys().hasOnly(['utrNormalized', 'requestId', 'createdAt']) &&
                       incoming().utrNormalized == utrId &&
                       isValidId(incoming().requestId) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       getAfter(/databases/$(database)/documents/payment_requests/$(incoming().requestId)).data.utrNormalized == utrId &&
                       (
                         (isSignedIn() && getAfter(/databases/$(database)/documents/payment_requests/$(incoming().requestId)).data.userId == request.auth.uid) ||
                         (
                           isValidPayId(incoming().requestId) && (
                             isValidPublicUid(getAfter(/databases/$(database)/documents/payment_requests/$(incoming().requestId)).data.userId) ||
                             isValidMobileStudentId(getAfter(/databases/$(database)/documents/payment_requests/$(incoming().requestId)).data.userId)
                           )
                         )
                       );
      allow update: if false;
      allow delete: if isAdmin() && isValidUtrKey(utrId);
    }

    // Permanent access codes collection (NEVER deleted)
    match /access_codes/{codeId} {
      allow get: if isValidId(codeId) && (
        isAdmin() ||
        resource == null ||
        (resource.data.status == 'unused' && resource.data.isUsed == false) ||
        (isSignedIn() && resource.data.usedByUserId == request.auth.uid)
      );
      allow list: if isAdmin();

      allow create: if isAdmin() &&
                       isValidId(codeId) &&
                       isValidAccessCode(incoming()) &&
                       incoming().code == codeId &&
                       incoming().status == 'unused' &&
                       incoming().isUsed == false;

      allow update: if isValidId(codeId) &&
                       isValidAccessCode(incoming()) &&
                       incoming().code == existing().code &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           existing().status == 'unused' &&
                           existing().isUsed == false &&
                           incoming().status == 'used' &&
                           incoming().isUsed == true &&
                           isValidUsedByMap(incoming().usedBy) &&
                           (
                             (isSignedIn() && incoming().usedByUserId == request.auth.uid && incoming().usedBy.uid == request.auth.uid) ||
                             (
                               (isValidPublicUid(incoming().usedByUserId) || isValidMobileStudentId(incoming().usedByUserId)) &&
                               incoming().usedBy.uid == incoming().usedByUserId
                             )
                           ) &&
                           incoming().usedByName == incoming().usedBy.name &&
                           incoming().usedByMobile == incoming().usedBy.mobile &&
                           incoming().usedAt is timestamp && incoming().usedAt <= request.time &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'status', 'isUsed', 'usedAt', 'usedBy',
                             'usedByUserId', 'usedByMobile', 'usedByName', 'updatedAt'
                           ])
                         )
                       );

      // Only verified admin can delete access codes
      allow delete: if isAdmin() && isValidId(codeId);
    }

    function isValidAppConfig(data) {
      return data.keys().hasAll(['releaseNotes', 'updatedAt']) &&
             data.keys().hasOnly([
               'githubOwnerRepo', 'releaseNotes', 'latestVersionName', 'latestVersionCode',
               'updateTitle', 'apkDownloadUrl', 'apkStoragePath', 'apkFileName',
               'apkSizeBytes', 'apkSha256', 'signingCertSha256', 'packageName',
               'isMandatory', 'publishedByUid', 'publishedAt', 'updatedAt'
             ]) &&
             (!('githubOwnerRepo' in data) || (data.githubOwnerRepo is string && data.githubOwnerRepo.size() <= 120)) &&
             data.releaseNotes is string && data.releaseNotes.size() <= 1000 &&
             (!('latestVersionName' in data) || (data.latestVersionName is string && data.latestVersionName.size() <= 32)) &&
             (!('latestVersionCode' in data) || (data.latestVersionCode is int && data.latestVersionCode >= 0 && data.latestVersionCode <= 1000000)) &&
             (!('updateTitle' in data) || (data.updateTitle is string && data.updateTitle.size() <= 120)) &&
             (!('apkDownloadUrl' in data) || (data.apkDownloadUrl is string && data.apkDownloadUrl.size() <= 2000)) &&
             (!('apkStoragePath' in data) || (data.apkStoragePath is string && data.apkStoragePath.size() <= 300)) &&
             (!('apkFileName' in data) || (data.apkFileName is string && data.apkFileName.size() <= 160)) &&
             (!('apkSizeBytes' in data) || (data.apkSizeBytes is int && data.apkSizeBytes >= 0 && data.apkSizeBytes <= 262144000)) &&
             (!('apkSha256' in data) || (data.apkSha256 is string && data.apkSha256.size() <= 64)) &&
             (!('signingCertSha256' in data) || (data.signingCertSha256 is string && data.signingCertSha256.size() <= 64)) &&
             (!('packageName' in data) || (data.packageName is string && data.packageName.size() <= 120)) &&
             (!('isMandatory' in data) || data.isMandatory is bool) &&
             (!('publishedByUid' in data) || (data.publishedByUid is string && data.publishedByUid.size() <= 128)) &&
             (!('publishedAt' in data) || data.publishedAt == null || (data.publishedAt is timestamp && data.publishedAt <= request.time)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /app_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(configId) && isValidAppConfig(incoming());
      allow delete: if false;
    }

    function isValidAppRelease(data) {
      return data.keys().hasAll([
               'versionName', 'versionCode', 'updateTitle', 'releaseNotes',
               'apkDownloadUrl', 'apkStoragePath', 'apkFileName', 'apkSizeBytes',
               'apkSha256', 'signingCertSha256', 'packageName', 'isMandatory',
               'publishedByUid', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'versionName', 'versionCode', 'updateTitle', 'releaseNotes',
               'apkDownloadUrl', 'apkStoragePath', 'apkFileName', 'apkSizeBytes',
               'apkSha256', 'signingCertSha256', 'packageName', 'isMandatory',
               'publishedByUid', 'createdAt', 'updatedAt'
             ]) &&
             data.versionName is string && data.versionName.size() >= 1 && data.versionName.size() <= 32 &&
             data.versionCode is int && data.versionCode >= 1 && data.versionCode <= 1000000 &&
             data.updateTitle is string && data.updateTitle.size() >= 1 && data.updateTitle.size() <= 120 &&
             data.releaseNotes is string && data.releaseNotes.size() <= 1000 &&
             data.apkDownloadUrl is string && data.apkDownloadUrl.size() >= 10 && data.apkDownloadUrl.size() <= 2000 &&
             data.apkDownloadUrl.matches('^https://.*') &&
             data.apkStoragePath is string && data.apkStoragePath.size() >= 5 && data.apkStoragePath.size() <= 300 &&
             data.apkFileName is string && data.apkFileName.size() >= 5 && data.apkFileName.size() <= 160 &&
             data.apkSizeBytes is int && data.apkSizeBytes >= 1 && data.apkSizeBytes <= 262144000 &&
             data.apkSha256 is string && data.apkSha256.size() <= 64 &&
             data.signingCertSha256 is string && data.signingCertSha256.size() <= 64 &&
             data.packageName is string && data.packageName.size() >= 3 && data.packageName.size() <= 120 &&
             data.isMandatory is bool &&
             data.publishedByUid is string && data.publishedByUid.size() >= 1 && data.publishedByUid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /app_releases/{releaseId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(releaseId) && isValidAppRelease(incoming());
      allow delete: if isAdmin() && isValidId(releaseId);
    }

    function isValidUpdateNotification(data) {
      return data.keys().hasAll([
               'releaseId', 'appName', 'versionName', 'versionCode', 'title', 'body',
               'isMandatory', 'apkDownloadUrl', 'targetRoute', 'pushDispatched',
               'recipientCount', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'releaseId', 'appName', 'versionName', 'versionCode', 'title', 'body',
               'isMandatory', 'apkDownloadUrl', 'targetRoute', 'pushDispatched',
               'recipientCount', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.releaseId) &&
             data.appName is string && data.appName.size() >= 1 && data.appName.size() <= 80 &&
             data.versionName is string && data.versionName.size() >= 1 && data.versionName.size() <= 32 &&
             data.versionCode is int && data.versionCode >= 1 && data.versionCode <= 1000000 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
             data.isMandatory is bool &&
             data.apkDownloadUrl is string && data.apkDownloadUrl.size() <= 2000 &&
             data.targetRoute == 'app_update' &&
             data.pushDispatched is bool &&
             data.recipientCount is int && data.recipientCount >= 0 && data.recipientCount <= 1000000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /update_notifications/{notifId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(notifId) && isValidUpdateNotification(incoming());
      allow delete: if isAdmin() && isValidId(notifId);
    }

    function isValidPushBroadcast(data) {
      return data.keys().hasAll([
               'category', 'title', 'body', 'targetRoute', 'referenceId',
               'senderUid', 'senderName', 'pushDispatched', 'recipientCount',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'category', 'title', 'body', 'targetRoute', 'referenceId',
               'senderUid', 'senderName', 'pushDispatched', 'recipientCount',
               'createdAt', 'updatedAt'
             ]) &&
             data.category in ['admin_message', 'exam_notice', 'app_update'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 600 &&
             data.targetRoute in ['home', 'mock_test', 'app_update', 'subject_maths', 'subject_science', 'subject_social_science', 'subject_english', 'subject_gujarati', 'subject_hindi'] &&
             data.referenceId is string && data.referenceId.size() <= 128 &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             data.pushDispatched is bool &&
             data.recipientCount is int && data.recipientCount >= 0 && data.recipientCount <= 1000000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /push_broadcasts/{broadcastId} {
      allow get, list: if true;
      allow create: if isAdmin() &&
                       isValidId(broadcastId) &&
                       isValidPushBroadcast(incoming()) &&
                       incoming().senderUid == request.auth.uid &&
                       incoming().pushDispatched == false &&
                       incoming().recipientCount == 0;
      allow update: if isAdmin() &&
                       isValidId(broadcastId) &&
                       isValidPushBroadcast(incoming()) &&
                       incoming().senderUid == existing().senderUid &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(broadcastId);
    }

    function isValidDeviceTokenDocId(deviceId) {
      return deviceId is string && deviceId.size() >= 8 && deviceId.size() <= 128 && deviceId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDeviceFcmToken(data) {
      return data.keys().hasAll([
               'deviceId', 'token', 'platform', 'appVersion', 'versionCode',
               'topicSubscribed', 'enabled', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'deviceId', 'token', 'platform', 'appVersion', 'versionCode',
               'topicSubscribed', 'enabled', 'createdAt', 'updatedAt'
             ]) &&
             isValidDeviceTokenDocId(data.deviceId) &&
             data.token is string && data.token.size() >= 20 && data.token.size() <= 512 &&
             data.platform in ['android', 'web'] &&
             data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 32 &&
             data.versionCode is int && data.versionCode >= 1 && data.versionCode <= 1000000 &&
             data.topicSubscribed is bool &&
             data.enabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /device_fcm_tokens/{deviceId} {
      allow get: if isAdmin() || isValidDeviceTokenDocId(deviceId);
      allow list: if isAdmin();
      allow create: if isValidDeviceTokenDocId(deviceId) &&
                       isValidDeviceFcmToken(incoming()) &&
                       incoming().deviceId == deviceId;
      allow update: if isValidDeviceTokenDocId(deviceId) &&
                       isValidDeviceFcmToken(incoming()) &&
                       incoming().deviceId == deviceId &&
                       incoming().deviceId == existing().deviceId &&
                       incoming().platform == existing().platform &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidDeviceTokenDocId(deviceId);
    }

    function isValidAdminSession(data) {
      return data.keys().hasAll(['activeDeviceId', 'activeDeviceName', 'updatedAt']) &&
             data.keys().hasOnly(['activeDeviceId', 'activeDeviceName', 'updatedAt']) &&
             data.activeDeviceId is string && data.activeDeviceId.size() <= 128 &&
             data.activeDeviceName is string && data.activeDeviceName.size() <= 120 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /admin_sessions/{sessionId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(sessionId) && isValidAdminSession(incoming());
      allow delete: if false;
    }

    // Payment requests collection
    match /payment_requests/{requestId} {
      allow get: if isAdmin() ||
                    (isSignedIn() && isValidId(requestId) && resource != null && resource.data.userId == request.auth.uid) ||
                    (isValidPayId(requestId) && (resource == null || isValidPublicUid(resource.data.userId) || isValidMobileStudentId(resource.data.userId)));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(requestId) &&
                       isValidPaymentRequest(incoming()) &&
                       (
                         (isSignedIn() && incoming().userId == request.auth.uid) ||
                         (
                           isValidPayId(requestId) &&
                           (isValidPublicUid(incoming().userId) || isValidMobileStudentId(incoming().userId))
                         )
                       ) &&
                       incoming().status == 'pending' &&
                       incoming().assignedCode == '' &&
                       incoming().adminNote == '' &&
                       !exists(/databases/$(database)/documents/utr_locks/$(incoming().utrNormalized)) &&
                       getAfter(/databases/$(database)/documents/utr_locks/$(incoming().utrNormalized)).data.requestId == requestId;

      allow update: if isAdmin() &&
                       isValidId(requestId) &&
                       isValidPaymentRequest(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().utrNormalized == existing().utrNormalized &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status == 'pending' &&
                       incoming().status in ['approved', 'rejected'] &&
                       (
                         incoming().status == 'rejected' ||
                         (
                           incoming().status == 'approved' &&
                           incoming().assignedCode.size() == 8 &&
                           getAfter(/databases/$(database)/documents/access_codes/$(incoming().assignedCode)).data.requestId == requestId
                         )
                       );

      allow delete: if isAdmin() && isValidId(requestId);
    }
  }
}
